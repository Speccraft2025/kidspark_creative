# Copy the KEYS into Netlify (Site settings -> Environment variables).
# For LOCAL testing only, copy this file to `.env` and fill it in.
# NEVER commit real keys. `.env` is gitignored.

# --- Paystack (from your Paystack Dashboard -> Settings -> API Keys) --------
# Use TEST keys while building, LIVE keys when you go live.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Supabase (Project Settings -> API) ------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # SECRET — server only, never in the browser
SUPABASE_BUCKET=printables

# --- Resend (resend.com -> API Keys) ---------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=KidSpark <downloads@yourdomain.com> # must be on your verified domain

# --- Currency (optional — code defaults to KES / KSh) ----------------------
CURRENCY=KES                                   # must match your Paystack account
CURRENCY_SYMBOL=KSh

# --- Your site ------------------------------------------------------------
SITE_URL=https://kidspark.cc                   # no trailing slash
